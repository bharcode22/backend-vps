// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id        String   @id @db.VarChar(100)
  status    String   @default("offline") @db.VarChar(20)
  lastSeen  DateTime @default(now()) @map("last_seen") @db.Timestamp()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("devices")
}

model AccessLog {
  id         Int      @id @default(autoincrement())
  deviceId   String?  @map("device_id") @db.VarChar(100)
  fileName   String?  @map("file_name") @db.VarChar(255)
  action     String?  @db.VarChar(50)
  accessTime DateTime @default(now()) @map("access_time") @db.Timestamp()

  @@map("access_logs")
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique @db.VarChar(100)
  password    String   @db.VarChar(255)
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(50)
  isOnline    Boolean  @default(false) @map("is_online")
  lastSeen    DateTime @default(now()) @map("last_seen") @db.Timestamp()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("users")
}

model Message {
  id             Int      @id @default(autoincrement())
  fromPhone      String   @map("from_phone") @db.VarChar(50)
  toPhone        String   @map("to_phone") @db.VarChar(50)
  content        String   @db.Text
  status         String   @default("sent") @db.VarChar(20)
  replyToId      Int?     @map("reply_to_id")
  replyToContent String?  @map("reply_to_content") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("messages")
}

model UploadedFile {
  id           Int      @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  filename     String   @unique @db.VarChar(255)
  size         Int
  mimeType     String   @map("mime_type") @db.VarChar(100)
  path         String   @db.VarChar(500)
  downloadUrl  String   @map("download_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("uploaded_files")
}


